"use client";

import Link from "next/link";
import React, { useEffect, useRef, useState } from "react";
import { Button } from "./ui/button";
import { Bell, Plus } from "lucide-react";
import ProfileButton from "./ProfileButton";
import { cn } from "@/lib/utils";

const Navbar = () => {
  const links = [
    { id: "local-destinations", label: "Local destinations", href: "#" },
    { id: "seasons", label: "Seasons", href: "#" },
    { id: "reviews", label: "Reviews", href: "#" },
    { id: "travel-tips", label: "Travel Tips", href: "#" },
  ];

  const [active, setActive] = useState("local-destinations");
  const [underlineStyle, setUnderlineStyle] = useState({ left: 0, width: 0 });

  const [isScrolled, setIsScrolled] = useState(false);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);

  const linkRefs = useRef<(HTMLAnchorElement | null)[]>([]);

  useEffect(() => {
    const handleScroll = () => {
      if (window.scrollY > 10) {
        setIsScrolled(true);
      } else {
        setIsScrolled(false);
      }
    };

    window.addEventListener("scroll", handleScroll);
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  useEffect(() => {
    const index = links.findIndex((link) => link.id === active);
    const currentLink = linkRefs.current[index];
    if (currentLink) {
      setUnderlineStyle({
        left: currentLink.offsetLeft,
        width: currentLink.offsetWidth,
      });
    }
  }, [active]);

  return (
    <nav className={cn("text-secondary fixed top-0 right-0 left-0 z-100 flex items-center justify-between px-8 text-sm font-semibold transition-all duration-300", isScrolled  ? "text-slightly-muted bg-background/95 backdrop-blur-md border-b shadow-sm py-3" : "bg-transparent py-5")}>
      <div className="container flex items-center justify-between">

      <div className="relative flex h-full gap-6">
        <span className="flex items-center">LOGO</span>
        <div className="flex items-center justify-stretch gap-8">
          {links.map(({ id, href, label }, i) => (
            <Link
            key={id}
            href={href}
            ref={(el) => {
              linkRefs.current[i] = el;
            }}
            className={cn({ "text-primary": active === id && isScrolled })}
            onClick={(e) => {
              // e.preventDefault();
              setActive(id);
            }}
            >
              {label}
            </Link>
          ))}
          {/* <span
            className="bg-primary absolute bottom-0 h-0.5 transition-all duration-300"
            style={{
              left: underlineStyle.left,
              width: underlineStyle.width,
              }}
              /> */}
        </div>
      </div>
      <div className="flex items-center gap-3">
        <Button className="h-full rounded-sm">
          <Plus />
          <span>Add Review</span>
        </Button>
        <Bell />
        <ProfileButton src="https://github.com/shadcn.png" />
              </div>
      </div>
    </nav>
  );
};

export default Navbar;


