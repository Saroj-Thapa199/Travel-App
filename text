const PublicTransportSegmentSchema = new Schema(
  {
    routeName: { type: String }, // E.g., "Kathmandu-Pokhara Highway"
    from: { type: String, required: true }, // Starting point (city/bus park)
    to: { type: String, required: true }, // Destination point
    options: [
      {
        vehicleType: {
          type: String,
          enum: ["Local Bus", "Deluxe Bus", "Microbus", "Hiace", "Tourist Bus"],
        },
        frequency: { type: String }, // "Every 30 minutes", "6AM-8PM"
        duration: { type: String }, // "6-8 hours"
        fareRange: { type: String }, // "Rs. 800-1500"
        booking: { type: String }, // "On spot", "Advance booking at Gongabu Bus Park"
        note: { type: String }, // "Deluxe buses more comfortable but costlier"
      },
    ],
    landmarks: [String], // Major stops along the way
  },
  { _id: false },
);

const personalVehicleSchema = z.array(
  z.object({
    recommendedRoute: requiredString(),
    distance: z.number().positive().optional(),
    approxTime: z.string().optional(),
    roadConditions: z
      .object({
        goodPercentage: z.number().min(0).max(100).optional(),
        fairPercentage: z.number().min(0).max(100).optional(),
        poorPercentage: z.number().min(0).max(100).optional(),
        offroadPercentage: z.number().min(0).max(100).optional(),
        description: z.string().optional(), // "First 50km is excellent, then 30km rough section"
        seasonalChanges: z.string().optional(), // "Worsens significantly during monsoon"
      })
      .optional(),
    fuelAvailability: z
      .object({
        hasStations: z.boolean(),
        stationsDescription: z.string().optional(), // "Only available in X and Y towns"
        recommendedStops: z.array(z.string()).optional(),
        note: z.string().optional(), // "Carry extra fuel for section between A and B"
      })
      .optional(),
    checkpoints: [
      {
        name: String,
        type: { type: String, enum: ["Police", "Customs", "Toll"] },
        note: String,
      },
    ],
    warnings: [String], // "Landslide prone area in monsoon"
    alternativeRoutes: [
      {
        route: String,
        pros: String,
        cons: String,
      },
    ],
  }),
   { _id: false },
);


const TrekSchema = new Schema(
  {
    trekName: { type: String }, // "Everest Base Camp Trek"
    startingPoint: { type: String, required: true }, // "Lukla"
    duration: {
      roundTrip: { type: String }, // "12-14 days"
      oneWay: { type: String }, // "7 days to EBC"
    },
    difficulty: {
      type: String,
      enum: ["Easy", "Moderate", "Challenging", "Difficult", "Extreme"],
    },
    elevation: {
      start: { type: Number }, // 2860m (Lukla)
      max: { type: Number }, // 5545m (Kala Patthar)
      gain: { type: Number }, // Total elevation gain
    },
    permits: [
      {
        name: String, // "TIMS", "Sagarmatha NP Entry"
        cost: String, // "Rs. 3000 for foreigners"
        where: String, // "Can be obtained in Kathmandu or Monjo"
      },
    ],
    teahouses: { type: Boolean }, // Availability of accommodations
    bestSeason: [String], // ["Oct-Nov", "Mar-Apr"]
    highlights: [String], // "Namche Bazaar, Tengboche Monastery"
    packingList: [String], // Essential items
    safetyTips: [String], // "Acclimatize properly"
  },
  { _id: false },
);
